    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "test": "tsx src/scripts/testSprint1.ts && tsx src/scripts/testSprint2.ts && tsx src/scripts/testSprint3.ts && tsx src/scripts/testSprint4.ts && tsx src/scripts/testSprint5.ts && tsx src/scripts/testSprint6.ts && tsx src/scripts/testE2E.ts && tsx src/scripts/smokeTest.ts",
    "test:sprint1": "tsx src/scripts/testSprint1.ts",
    "test:sprint2": "tsx src/scripts/testSprint2.ts",
    "test:sprint3": "tsx src/scripts/testSprint3.ts",
    "test:sprint4": "tsx src/scripts/testSprint4.ts",
    "test:sprint5": "tsx src/scripts/testSprint5.ts",
    "test:sprint6": "tsx src/scripts/testSprint6.ts",
    "test:e2e": "tsx src/scripts/testE2E.ts",
    "test:smoke": "tsx src/scripts/smokeTest.ts",
    "test:omni": "tsx src/scripts/testOmniRoute.ts",
    "test:db": "tsx src/scripts/testMongoConnection.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nexora/core": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "xmlrpc": "^1.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/xmlrpc": "^1.3.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
