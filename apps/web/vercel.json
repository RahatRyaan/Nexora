{
  "buildCommand": "npm run build --workspace=@nexora/core && npm run build --workspace=@nexora/web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexora-agentic-erp.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
