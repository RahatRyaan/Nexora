# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure the credentials for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nexora_erp
MONGODB_TEST_URI=mongodb://localhost:27017/nexora_erp_test

# Redis Connection (BullMQ, Event Bus, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_jwt_secret_minimum_32_chars
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_secret_minimum_32_chars
REFRESH_TOKEN_EXPIRATION=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# AI PROVIDER SETTINGS (Choose your preferred provider)
# Supported options: "anthropic" | "omniroute" | "openai" | "gemini" | "openai_compatible"
# ==============================================================================
AI_PROVIDER=anthropic

# --- Option A: Anthropic Claude (Recommended) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Option B: OmniRoute / OpenRouter / HuggingFace / Groq / Together AI ---
OMNIROUTE_API_KEY=your_omniroute_or_openrouter_or_hf_key_here
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=claude-3-5-sonnet

# --- Option C: Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# --- Option D: OpenAI (GPT-4o) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# General Agent Tuning
AGENT_TEMPERATURE=0.1
AGENT_REQUEST_TIMEOUT_MS=20000

# Policy & Trust Governance Defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.85
SUPPORT_MAX_AUTO_REFUND_DOLLARS=100
SALES_AUTO_OUTREACH_THRESHOLD=0.90
FINANCE_STRICT_HUMAN_APPROVAL=true

# Odoo ERP Connector (Sandbox)
ODOO_HOST=https://demo.odoo.com
ODOO_DB=odoo_db_demo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin_api_token
ODOO_VERSION=17.0

# Mock ERP Server (Deterministic offline testing)
MOCK_ERP_ENABLED=true
MOCK_ERP_PORT=5050

# Email & Notifications (Optional / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
EMAIL_FROM=no-reply@nexora.ai
