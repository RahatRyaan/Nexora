{
  "name": "nexora-root",
  "version": "0.1.0-foundation",
  "private": true,
  "description": "Nexora: The Agentic ERP Layer for Sales, Support & Finance",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@nexora/api\" \"npm run dev --workspace=@nexora/web\"",
    "dev:api": "npm run dev --workspace=@nexora/api",
    "dev:web": "npm run dev --workspace=@nexora/web",
    "build": "npm run build --workspace=@nexora/core && npm run build --workspace=@nexora/api && npm run build --workspace=@nexora/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
